# Data & Models (large files)
# Ignore entire directories with large training data
runs/*/activations/
checkpoints/*/

# Ignore model files
*.pt
*.pth
*.safetensors
*.bin
*.ckpt
*.weights

# Ignore large JSON datasets (>50MB)
runs/*/ioi_dataset.json

# Keep small metadata files
!runs/*/meta.json
!checkpoints/**/config.json
!checkpoints/**/training_args.json

# Results
*.png
*.jpg
*.jpeg
*.gif
*.html

# Keep result JSONs
!results/**/*.json

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db
*.tmp

# Temporary
temp/
tmp/
